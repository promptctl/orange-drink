# The throwaway Tart VM the checks that must not touch this Mac's screen run in: scripts/update-check,
# scripts/login-item-check, scripts/first-launch-check, scripts/battery-notification-check, scripts/widget-click-check,
# scripts/vm-test, and scripts/ui-test source
# this under `set -euo pipefail`, so nothing shows on the Mac running them. A check may set:
#   image        before sourcing: the Tart image to clone, for a check on another macOS
#   vm_cleanup   directories to remove however the run ends, beside the scratch directory
#   uitest_env   NAME=value words for its XCUITests; xcodebuild passes each TEST_RUNNER_ variable without that prefix
#   on_failure   a function printing the guest's logs it wants when a run fails with the VM up

image=${image:-orange-drink-xcode}
vm=orange-drink-check-$$
scratch=$(realpath "$(mktemp -d "${TMPDIR:-/tmp}/orangedrink-vm-check.XXXXXX")")
# The VM's view of $scratch, and of itself: it is new each run, so its paths are fixed.
shared='/Volumes/My Shared Files/run'
app=/Users/admin/Applications/OrangeDrink.app
tests=/tmp/tests
cloned=
vm_cleanup=()
uitest_env=()
failed_because=
on_failure() { :; }

# Stops and deletes the VM, with everything that happened in it, and removes what the run left on this Mac, whether or
# not a VM came up: a check's secrets are in those directories before the clone. Every step runs whatever the last one
# did, and the run keeps its own status, so errexit ends here.
# A run that fails says so on one marked line, which is what scripts/hardware-check.swift records as the check's reason.
# It is here, where every way a run ends passes, so a command that failed under errexit is recorded too, and it names the
# image, because a check run on several macOS versions records them as one result.
vm_finish() {
  status=$?
  set +e
  [ "$status" -eq 0 ] || echo "» failure: $(basename "$0") on $image: ${failed_because:-exited $status}" >&2
  if [ -n "$cloned" ]; then
    [ "$status" -eq 0 ] || on_failure
    tart stop "$vm" >&2
    tart delete "$vm" >&2
  fi
  # The guarded expansion, because macOS's bash 3.2 calls an empty array unbound under `set -u`.
  rm -rf "$scratch" ${vm_cleanup[@]+"${vm_cleanup[@]}"}
  exit "$status"
}
trap vm_finish EXIT

fail() { failed_because=$*; echo "$(basename "$0"): $*" >&2; exit 1; }
guest() { tart exec "$vm" "$@"; }
pids() { guest pgrep -f "^$app/Contents/MacOS/OrangeDrink( |\$)" || true; }
# [LAW:no-ambient-temporal-coupling] Each wait is on the fact it needs, polled to a deadline.
wait_for() {
  local what=$1 tries=$2; shift 2
  for _ in $(seq 1 "$tries"); do
    if "$@" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  fail "$what"
}
stopped() { [ -z "$(pids)" ]; }
# Quits the app and waits for it to be gone, saying <when> if it is not. A copy already gone is quit, so only the wait can fail.
quit_app() {
  guest pkill -x OrangeDrink || true
  wait_for "the app did not quit $1" 30 stopped
}
# What the app logged in <category>. `logged` is for a line that must come: a here-string drops the read's status, so a
# read that failed says it has not. Whatever says a line is absent reads the log itself.
log_matching() { guest /usr/bin/log show --last 30m --info --style compact --predicate "$1"; }
log_lines() { log_matching "category == \"$1\""; }
logged() { grep -qF "$2" <<<"$(log_lines "$1")"; }
# The guest's clock now, and what the app logged in devices since such a time, for a stage whose lines an earlier stage
# logged too. `log show --info` holds info lines from before any `log config`, so a time is what anchors one.
guest_now() { guest date '+%Y-%m-%d %H:%M:%S'; }
devices_since() { guest /usr/bin/log show --start "$1" --info --style compact --predicate 'category == "devices"'; }
refused_since() { grep -qF 'bluetooth permission answered: denied' <<<"$(devices_since "$1")"; }
# What follows <pattern> in <log>. A line of a stage before it is not a line of this one.
log_after() { sed -n "/$1/,\$p" <<<"$2"; }

# `tart get` knows only local VMs, and a check naming a pulled image hears from `tart clone` if it is gone.
[ "$image" != orange-drink-xcode ] || tart get "$image" >/dev/null || fail "no VM named $image: tart clone ghcr.io/cirruslabs/macos-tahoe-xcode:26.5 $image"

# Clones and boots the VM with no window. This is all an image with no Xcode can take.
vm_boot() {
  tart clone "$image" "$vm"
  cloned=yes
  tart run --no-graphics --dir="run:$scratch:ro" "$vm" >&2 &
  wait_for "the VM did not come up" 180 guest true
}

# Boots the VM with the built tests beside <xctestrun> unpacked in it.
vm_start() {
  xctestrun=$1
  # One file, because the VM's shared directory does not carry a framework's symbolic links.
  tar -C "$(dirname "$xctestrun")" -cf "$scratch/tests.tar" .
  vm_boot
  guest sudo -n automationmodetool enable-automationmode-without-authentication >&2
  guest sh -c "mkdir $tests && tar -C $tests -xf '$shared/tests.tar'"
}

# Installs the app from the disk image at <path in the guest>, as a user does.
install_dmg() {
  guest sh -c "mkdir -p '$(dirname "$app")' /tmp/image && hdiutil attach '$1' -nobrowse -readonly -mountpoint /tmp/image >/dev/null && ditto /tmp/image/OrangeDrink.app '$app' && hdiutil detach /tmp/image >/dev/null"
}

# Runs <only-testing> of the built tests in the guest, with [NAME=value...] set and the result bundle at /tmp/<result>.xcresult.
xctest() {
  local result=$1 only_testing=$2; shift 2
  guest env "$@" xcodebuild test-without-building -xctestrun "$tests/$(basename "$xctestrun")" \
    -destination 'platform=macOS,arch=arm64' -resultBundlePath "/tmp/$result.xcresult" "-only-testing:$only_testing" >&2
}

# Runs one XCUITest, <Class>/<method>, against the installed app.
uitest() {
  xctest "${1##*/}" "OrangeDrinkUITests/$1" TEST_RUNNER_INSTALLED_APP="$app" ${uitest_env[@]+"${uitest_env[@]}"} ||
    fail "$1 failed in the VM"
}

# macOS asks for Bluetooth at a new install's first launch, and its prompt floats over the windows a check presses, so
# this opens the app itself and FirstLaunchUITests answers. No launch after this one asks.
first_launch() {
  guest open "$app"
  uitest FirstLaunchUITests/testBluetoothIsAllowed
  quit_app "after its first launch"
}
