#!/bin/bash
# Launch at login on real macOS, inside a throwaway VM with no window, because registering a login item posts a
# notification on the Mac it happens on. Installs the app from its disk image, has the XCUITests press the General
# screen's switch on and then off, and reads what SMAppService.mainApp.status said after each from the app's own log. Run
# by `make login-item-check`.
#
#   scripts/login-item-check <dmg> <xctestrun of the OrangeDrinkUITests scheme>
#
# Exits 0 when both readings hold and 1 naming the first that does not.
set -euo pipefail

usage='usage: scripts/login-item-check <dmg> <xctestrun>'
dmg=$(realpath "${1:?$usage}")
xctestrun=$(realpath "${2:?$usage}")
cd "$(dirname "$0")/.."

. scripts/vm-check-lib

log_lines() { guest /usr/bin/log show --last 30m --style compact --predicate 'category == "launchAtLogin"'; }
on_failure() { log_lines >&2; }
# [LAW:no-ambient-temporal-coupling] The switch moves when the status has landed, so the line is written by then, but the
# log store can lag a moment behind its writer.
said() { log_lines | grep -F "launch at login $1: status $2"; }

cp "$dmg" "$scratch/app.dmg"
vm_start "$xctestrun"
# Attached from the VM's own disk, because it can go on reading a shared file as it was.
guest cp "$shared/app.dmg" /tmp/app.dmg
install_dmg /tmp/app.dmg
first_launch

uitest LaunchAtLoginUITests/testTurningOn
wait_for "the app never logged status enabled after the switch went on" 30 said on enabled
echo "login-item-check: on: SMAppService.mainApp.status is enabled" >&2

uitest LaunchAtLoginUITests/testTurningOff
wait_for "the app never logged status notRegistered after the switch went off" 30 said off notRegistered
echo "login-item-check: off: SMAppService.mainApp.status is notRegistered" >&2
