#!/bin/bash
# Closing macOS's low battery notification on real macOS, in a throwaway VM with no window. A stand-in battery raises the
# real notification from ControlCenter's own code, which only a real discharge does on a Mac with a battery. Everything it
# asserts is read from NotificationCenter's accessibility tree: the app's Developer ID build is started as `tart exec`
# starts it, which is what gives it Accessibility here, and nothing in the check presses the notification. That the switch
# prompts is a stand-in test's job, in `make test`. Run by `make battery-notification-check`, once per image.
#
#   scripts/battery-notification-check <app> <tart image>
#
# Exits 0 when every reading holds and 1 naming the first that does not.
set -euo pipefail

usage='usage: scripts/battery-notification-check <app> <tart image>'
built=$(realpath "${1:?$usage}")
image=${2:?$usage}
cd "$(dirname "$0")/.."

. scripts/vm-check-lib
. scripts/notification-vm-lib

binary=$app/Contents/MacOS/OrangeDrink

# A here-string drops its command's status, so a read that failed would be a tree showing nothing. Whatever says something
# is gone reads through this, and a failed read says it is not.
read_tree() { showing=$(list); }
on_failure() {
  log_lines batteryNotifications >&2
  log_lines devices >&2
  guest sh -c 'cat /tmp/app.out /tmp/battery.out' >&2
  list >&2
}
say() { echo "battery-notification-check: $image: $*" >&2; }

start_app() { guest sh -c "nohup '$binary' >/tmp/app.out 2>&1 &"; }

has_alert() { grep -q '^AXNotificationCenterAlert' <<<"$(list)"; }
shows() { read_tree && grep -qxF "$1" <<<"$showing"; }
# Whether anything beyond those the app's own launch left is an alert.
nothing_new() { read_tree && [ -z "$(new_alerts "$showing" "$installed")" ]; }
closes() { log_lines batteryNotifications | awk '/, closed$/ { n++ } END { print n + 0 }'; }
closed_after() { [ "$(closes)" -gt "$1" ]; }

tar -C "$(dirname "$built")" -cf "$scratch/app.tar" "$(basename "$built")"

notification_setup
guest sh -c "mkdir -p '$(dirname "$app")' && tar -C '$(dirname "$app")' -xf '$shared/app.tar'"
identifier=$(guest /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")

# The first launch raises the Bluetooth prompt, and these images have no Xcode for FirstLaunchUITests to answer it. This
# is the one run of that answer on macOS 14 and 15, so it is read here too. The launch also posts the system's login items
# alert, which stays up.
start_app
wait_for "the Bluetooth prompt never showed" 30 guest "$tree" answer Allow
wait_for "the app never logged the Bluetooth answer" 30 logged devices 'bluetooth permission answered: allowed'
wait_for "the device watcher never started after the answer" 30 logged devices 'device watcher started'
wait_for "the app's first pass never logged" 30 logged batteryNotifications 'pass: '
wait_for "the login items alert never showed" 30 has_alert
installed=$(grep '^AXNotificationCenterAlert' <<<"$(list)")

wait_for "the low battery notification never showed" 30 raise "$first" "$installed"
read_tree
alert=$(new_alerts "$showing" "$installed")
sleep 5
shows "$alert" || fail "with the switch off, the low battery alert did not stay"
say "off: the low battery alert stayed for 5 seconds: $alert"

gone() { read_tree && ! grep -qxF "$alert" <<<"$showing"; }
warn 1
wait_for "macOS did not withdraw the alert when the warning ended" 10 gone

guest pkill -x OrangeDrink
wait_for "the app did not quit" 30 stopped
guest defaults write "$identifier" systemNotifications -data "$(printf '%s' '{"dismissBatteryNotifications":true}' | xxd -p | tr -d '\n')"
start_app
wait_for "the app never read the switch on and itself trusted" 30 logged batteryNotifications 'switch on, trusted'

# Times the alert from the guest, at 50 ms: reading the log takes seconds of its own, and the app logs `closed` only after
# its deadline. The watcher starts first, so an alert that goes fast cannot pass it unseen.
gone_within_5_seconds() {
  guest "$tree" goes "$alert" 5 >&2 &
  local watcher=$!
  sleep 2
  warn "$1"
  wait "$watcher"
}

before=$(closes)
# Before anything else moves in NotificationCenter: another event would wake the app and hide a first look that came early.
gone_within_5_seconds "$first"
wait_for "with the switch on, the log never said closed" 8 closed_after "$before"
while IFS= read -r line; do shows "$line" || fail "this did not stay: $line"; done <<<"$installed"
say "on: the alert closed with no press from the check, and the login items alert stayed"

if [ "$first" -eq 2 ]; then
  warn 3
  sleep 3
  nothing_new || fail "the final warning showed something after the early warning's alert was closed"
  say "the final warning brought nothing new"
else
  warn 1
  warn 2
  sleep 3
  nothing_new || fail "the early warning showed an alert on macOS 26"
  before=$(closes)
  gone_within_5_seconds 3
  wait_for "the log never said the final warning's alert was closed" 8 closed_after "$before"
  say "the early warning left nothing to close, and the final warning's alert closed"
fi

# Another app's with the same words, in the same moment. A banner fades, and the close is confirmed only after its deadline,
# so the watcher in the guest is what sees the alert go with the other still showing. On macOS 26 the alert has to be first.
warn 1
before=$(closes)
IFS=$'\t' read -r _ title body _ <<<"$alert"
{ warn "$first"; post "$title" "$body"; } &
other=$(guest "$tree" closes "$alert" 20)
wait $!
wait_for "the log never said the alert beside Script Editor's was closed" 8 closed_after "$before"
say "the alert closed and Script Editor's notification with the same words stayed: $other"

# A timed ask of an allowed app, the one run of it on macOS 14 and 15: a new manager that refused an allowed app would stop
# every Mac's list at its first minute, and the refusal below could not tell that from a real one. The ask's state line is at
# info, which this check keeps for its own reading.
guest sudo -n log config --subsystem "$identifier" --mode 'level:info,persist:info' >&2
kept=$(guest_now)
swept_on_a_timed_ask() { grep -qF 'device sweep:' <<<"$(log_after 'bluetooth permission: state .*authorization 3' "$(devices_since "$kept")")"; }
wait_for "the running app never swept on a timed ask" 150 swept_on_a_timed_ask
lines=$(devices_since "$kept")
! grep -qF 'bluetooth permission answered: denied' <<<"$lines" || fail "a new manager refused the allowed app"
! grep -qF 'device watcher stopped' <<<"$lines" || fail "the device watcher stopped with the app allowed"
say "allowed: a timed ask of the running app said allowed, and it swept"

# Every client's grant: one naming the app's bundle leaves this one standing, for an app `tart exec` started. Such an app reads
# the reset at once, as a question open again: its next ask stops the watcher and macOS asks it anew. The answer reaches that
# ask, and the ask after it is a new manager refusing a running app, the one run of that on macOS 14 and 15.
taken=$(guest_now)
guest tccutil reset BluetoothAlways
stopped_since() { grep -qF 'device watcher stopped' <<<"$(devices_since "$taken")"; }
wait_for "the app never stopped its device watcher" 90 stopped_since
wait_for "the Bluetooth prompt never came to the running app" 90 guest "$tree" answer 'Don’t Allow'
refused_by_a_new_manager() { grep -qF 'bluetooth permission: state 3' <<<"$(log_after 'bluetooth permission answered: denied' "$(devices_since "$taken")")"; }
wait_for "the running app never logged the refusal" 30 refused_since "$taken"
wait_for "a new manager never refused the running app" 90 refused_by_a_new_manager
say "taken away: the running app stopped its device watcher, and a new manager refused it"

# A refusal never reaches IOBluetooth: nothing past it sweeps, so a sweep means the list was read. macOS 14 and 15 are read
# nowhere else.
guest pkill -x OrangeDrink
wait_for "the app did not quit" 30 stopped
guest tccutil reset BluetoothAlways
# Anchored here, because the stage above logged the same refusal.
relaunched=$(guest_now)
start_app
wait_for "the Bluetooth prompt never came back after the reset" 30 guest "$tree" answer 'Don’t Allow'
wait_for "the app never logged the refusal" 30 refused_since "$relaunched"
# The line follows the answer within the second when it comes, so its absence is read after a few.
sleep 5
# At the top level, because errexit stops at a log that cannot be read only here: in a function's $() it would read as no line.
lines=$(devices_since "$relaunched")
refused=$(log_after 'bluetooth permission answered: denied' "$lines")
[ -n "$refused" ] || fail "the log no longer holds the refusal"
! grep -qF 'device watcher started' <<<"$refused" || fail "the device watcher started after the refusal"
say "denied: the app logged the refusal and did not start the device watcher"
