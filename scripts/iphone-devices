#!/usr/bin/env python3
# What usbmuxd (macOS's USB and Wi-Fi-sync device multiplexer) knows about iPhones and iPads, read the way the app reads them.
#
#   scripts/iphone-devices list            prints usbmuxd's ListDevices reply, one device per line
#   scripts/iphone-devices capture <dir>   writes every listed device's IOPMPowerSource reply into <dir>
#
# capture writes one XML plist per listing, named <ProductType>-<ProductVersion>-<udid>-<ConnectionType>.plist (a device on
# both cable and Wi-Fi is listed, and captured, twice). Each file holds the diagnostics relay's reply plus a top-level "Device"
# dict (ProductType, ProductVersion, DeviceClass, ConnectionType) so a fixture cut from it can name the device and OS it came
# from. IOPMPowerSource, not AppleSmartBattery: the Vision Pro answers only to the superclass (orange-iphone-watch-lm3.7iy
# cmt-9996a69e). The files hold the full reply, serial numbers included: keep them outside the repo and commit only the
# allowlisted keys. Exits 1 if any listed device could not be captured.
#
# USBMUXD_SOCKET names the socket to talk to (default /var/run/usbmuxd); scripts/iphone-devices-test.py points it at a stand-in.
#
# Run as `python3 -I scripts/iphone-devices ...` or through `make iphone-list` and `make iphone-capture DIR=<dir>`.
import contextlib
import os
import plistlib
import re
import socket
import ssl
import struct
import sys
import tempfile

LOCKDOWN_PORT = 62078
SOCKET_PATH = os.environ.get("USBMUXD_SOCKET", "/var/run/usbmuxd")


# usbmuxd frame: <u32 len><u32 version=1><u32 type=8 plist><u32 tag> + XML plist, little-endian.
def mux(msg_type, extra=None):
    body = {"MessageType": msg_type, "ClientVersionString": "orange-drink", "ProgName": "iphone-devices"}
    body.update(extra or {})
    payload = plistlib.dumps(body)
    s = socket.socket(socket.AF_UNIX)
    s.connect(SOCKET_PATH)
    s.sendall(struct.pack("<IIII", 16 + len(payload), 1, 8, 1) + payload)
    return s


def read_exactly(s, n):
    data = b""
    while len(data) < n:
        chunk = s.recv(n - len(data))
        if not chunk:
            raise RuntimeError(f"connection closed after {len(data)} of {n} bytes")
        data += chunk
    return data


def read_mux(s):
    n = struct.unpack("<I", read_exactly(s, 16)[:4])[0]
    return plistlib.loads(read_exactly(s, n - 16))


# Lockdown and the services behind it frame a plist as <u32 len, big-endian> + plist.
def send(s, msg):
    p = plistlib.dumps(msg)
    s.sendall(struct.pack(">I", len(p)) + p)


def recv(s):
    n = struct.unpack(">I", read_exactly(s, 4))[0]
    return plistlib.loads(read_exactly(s, n))


# A lockdown request and its reply; lockdown answers a refusal (locked device, stale pair record) with an Error key.
def call(s, msg):
    send(s, msg)
    reply = recv(s)
    if "Error" in reply:
        raise RuntimeError(f"lockdown refused {msg['Request']}: {reply}")
    return reply


def wrap_tls(sock, pair):
    # load_cert_chain reads files; the directory is 0700 and gone when the context is built.
    with tempfile.TemporaryDirectory() as tmp:
        cert, key = os.path.join(tmp, "c.pem"), os.path.join(tmp, "k.pem")
        for path, data in ((cert, pair["HostCertificate"]), (key, pair["HostPrivateKey"])):
            with open(path, "wb") as f:
                f.write(data)
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        ctx.load_cert_chain(cert, key)
    return ctx.wrap_socket(sock)


# One request, one reply, socket closed: the mux conversations that are not a tunnel to a device.
def ask(msg_type, extra=None):
    with mux(msg_type, extra) as s:
        return read_mux(s)


# usbmuxd answers Connect with Number 0 when the tunnel is open, and anything else when the device refused or is gone.
def connect(device_id, port):
    s = mux("Connect", {"DeviceID": device_id, "PortNumber": socket.htons(port)})
    try:
        reply = read_mux(s)
        if reply.get("Number") != 0:
            raise RuntimeError(f"usbmuxd refused Connect to device {device_id} port {port}: {reply}")
    except BaseException:
        s.close()
        raise
    return s


def list_devices():
    return ask("ListDevices")["DeviceList"]


def capture(d, out_dir):
    udid, dev_id, conn = d["Properties"]["SerialNumber"], d["DeviceID"], d["Properties"].get("ConnectionType")
    record = ask("ReadPairRecord", {"PairRecordID": udid})
    if "PairRecordData" not in record:
        raise RuntimeError(f"{udid} ({conn}): no pair record, the device has not trusted this Mac: {record}")
    pair = plistlib.loads(record["PairRecordData"])
    with contextlib.ExitStack() as open_sockets:
        s = open_sockets.enter_context(connect(dev_id, LOCKDOWN_PORT))
        session = call(s, {"Request": "StartSession", "HostID": pair["HostID"], "SystemBUID": pair["SystemBUID"]})
        if session.get("EnableSessionSSL"):
            s = open_sockets.enter_context(wrap_tls(s, pair))
        device = {"ConnectionType": conn}
        for key in ("ProductType", "ProductVersion", "DeviceClass"):
            device[key] = call(s, {"Request": "GetValue", "Key": key})["Value"]
        svc = call(s, {"Request": "StartService", "Service": "com.apple.mobile.diagnostics_relay"})
        r = open_sockets.enter_context(connect(dev_id, svc["Port"]))
        if svc.get("EnableServiceSSL"):
            r = open_sockets.enter_context(wrap_tls(r, pair))
        send(r, {"Request": "IORegistry", "EntryClass": "IOPMPowerSource"})
        n = struct.unpack(">I", read_exactly(r, 4))[0]
        raw = read_exactly(r, n)
    reply = plistlib.loads(re.sub(rb"[\x00-\x08\x0b\x0c\x0e-\x1f]", b"", raw))
    entry = reply.get("Diagnostics", {}).get("IORegistry")
    if not entry:
        raise RuntimeError(f"{udid} ({conn}): the relay's reply has no IORegistry entry: {reply}")
    reply["Device"] = device
    path = os.path.join(out_dir, f"{device['ProductType']}-{device['ProductVersion']}-{udid}-{conn}.plist")
    with open(path, "wb") as f:
        f.write(plistlib.dumps(reply, fmt=plistlib.FMT_XML))
    print(path, device, "entry keys:", len(entry))


def main(argv):
    if argv[:1] == ["list"] and len(argv) == 1:
        devices = list_devices()
        for d in devices:
            print(d)
        print(f"{len(devices)} device(s) listed")
        return 0
    if argv[:1] == ["capture"] and len(argv) == 2:
        os.makedirs(argv[1], exist_ok=True)
        failed = 0
        for d in list_devices():
            try:
                capture(d, argv[1])
            except Exception as e:
                failed += 1
                print("FAILED", d["Properties"].get("SerialNumber"), repr(e), file=sys.stderr)
        return 1 if failed else 0
    print("usage: iphone-devices list | iphone-devices capture <dir>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
