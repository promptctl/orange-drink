#!/bin/bash
# Hosted tests inside a throwaway VM with no window, for a test that puts something on the screen, such as
# PinnedPositionCheck's status items. The test that reads the string catalog through #filePath compiled to this Mac's path, so
# a copy of the tree sits at the same path in the VM. Run by `make position-check`.
#
#   scripts/vm-test <xctestrun of the OrangeDrink scheme> <Suite/function() under OrangeDrinkTests> [TEST_RUNNER_NAME=value...]
#
# Prints the result bundle's summary, and exits 0 only when the test ran and passed: a skip, or no test matched, fails.
set -euo pipefail

usage='usage: scripts/vm-test <xctestrun> <test> [TEST_RUNNER_NAME=value...]'
xctestrun=$(realpath "${1:?$usage}")
only=${2:?$usage}
shift 2
cd "$(dirname "$0")/.."
. scripts/vm-check-lib

tar --exclude ./.git --exclude ./.claude --exclude ./build -cf "$scratch/tree.tar" .
vm_start "$xctestrun"
guest sudo -n sh -c "mkdir -p '$PWD' && tar -C '$PWD' -xf '$shared/tree.tar'"

status=0
xctest vm-test "OrangeDrinkTests/$only" "$@" || status=$?
summary=$(guest xcrun xcresulttool get test-results summary --path /tmp/vm-test.xcresult --compact)
echo "$summary"
[ "$status" -eq 0 ] || fail "$only failed in the VM"
python3 -c 'import json, sys; s = json.load(sys.stdin); sys.exit(not (s["passedTests"] >= 1 and s["skippedTests"] == 0 and s["failedTests"] == 0))' <<<"$summary" ||
  fail "$only did not run and pass in the VM; the summary above says what ran"
