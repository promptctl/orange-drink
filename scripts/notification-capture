#!/bin/bash
# What NotificationCenter's accessibility tree shows for macOS's low battery notification, and for another app's with the same words,
# on the macOS of one Tart image, in a throwaway VM with no window. It prints a raw capture on stdout (scripts/notification-fixtures says
# what one is) and its progress on stderr: the macOS version, then every reading of the sweep, each tagged with its step.
# Run by `make notification-fixtures` and `make notification-fixtures-check`, once per image.
#
#   scripts/notification-capture <tart image>
#
# Exits 0 with the whole sweep printed, and 1 naming the step that never showed what it waited for.
set -euo pipefail

usage='usage: scripts/notification-capture <tart image>'
image=${1:?$usage}
cd "$(dirname "$0")/.."

# Stdout is the capture and nothing else: fd 3 keeps it, and whatever tart or the guest prints goes to stderr.
exec 3>&1 1>&2

. scripts/vm-check-lib
. scripts/notification-vm-lib

# The Mac's English is the first reading; these are the other languages the app is held to read, in the capture's order.
languages=(fr-FR ja zh-Hans ar pt-BR pl)

on_failure() {
  guest cat /tmp/battery.out >&2
  list >&2
}
say() { echo "notification-capture: $image: $*" >&2; }

# Whether the tree shows nothing at all. A tree that could not be read is not an empty one.
nothing_showing() { local showing; showing=$(list) && [ -z "$showing" ]; }
stack_gone() { local showing; showing=$(list) && ! grep -q '^AXNotificationCenterBannerStack' <<<"$showing"; }

# Prints the tree's notifications as records of <step> if one look at it shows every subrole given: a banner fades, so a second look
# can find it gone. A tree that could not be read ends the run, as it is not one without the subroles.
look() {
  local step=$1 seen subrole line
  shift
  seen=$(guest "$tree" values) || fail "$step: the tree could not be read"
  # The whole subrole field: AXNotificationCenterBanner is not AXNotificationCenterBannerStack.
  for subrole; do grep -q "^$subrole"$'\t' <<<"$seen" || return 1; done
  while IFS= read -r line; do printf '%s\t%s\n' "$step" "$line" >&3; done <<<"$seen"
}
# Looks until the tree shows every subrole, from the look that saw them.
snapshot() {
  local step=$1
  for _ in $(seq 1 150); do look "$@" && return 0; done
  shift
  fail "$step: the tree never showed $*"
}

# Posts the words and looks, for wait_for. A restart of NotificationCenter ends its launch by rebuilding its notification list, and that
# clears a banner posted before it ends (live, in a run that failed at a language step: the log read "Clearing banner to update root
# model" 80ms after the banner was set), so a banner that does not show is posted again.
banner_beside_alert() {
  post "$2" "$3"
  sleep 2
  look "$1" AXNotificationCenterAlert AXNotificationCenterBanner
}

# Raises the final warning, and has Script Editor post the alert's own words: on macOS 26 a notification takes the top-right corner
# from a banner already showing, so the alert comes first.
alert_and_banner() {
  local alert
  wait_for "$1: the low battery alert never showed" 60 raise 3 ""
  read -r alert <<<"$(new_alerts "$(list)" "")"
  [ -n "$alert" ] || fail "$1: the alert that showed was gone when its words were read"
  wait_for "$1: the tree never showed the alert and Script Editor's banner" 30 banner_beside_alert "$1" "$(cut -f2 <<<"$alert")" "$(cut -f3 <<<"$alert")"
}

# Withdraws the warning until nothing shows, as `raise` raises it until an alert does. On macOS 26 the French step's alert stayed up for
# the whole wait in about half the runs while `warn 1` was sent again and again; sending 3 and then 1 took it down (a live probe of
# the stuck alert), so a withdrawal that finds something showing is a change of level, as `raise`'s is. The banners fade meanwhile,
# so the next step starts from nothing showing.
withdrawn() { nothing_showing || { warn 3; warn 1; sleep 2; nothing_showing; }; }
clear_all() { wait_for "$1: the notifications never went" 60 withdrawn; }

notification_setup
printf 'macos\t%s\n' "$(guest sw_vers -productVersion)" >&3

post First 'A banner'
snapshot banner AXNotificationCenterBanner
say "banner"
wait_for "banner: the banner never went" 60 nothing_showing

alert_and_banner final-warning
say "final-warning"
clear_all final-warning

# The stack is the banner above, kept in the panel. The clock toggles the panel, so it is pressed for the stack to show, read,
# and pressed again, and the stack is waited out: no reading after this is taken under an open panel.
wait_for "panel: the low battery alert never showed" 60 raise 3 ""
guest "$tree" panel
snapshot panel AXNotificationCenterAlert AXNotificationCenterBannerStack
guest "$tree" panel
wait_for "panel: the panel never closed" 30 stack_gone
say "panel"
clear_all panel

for language in "${languages[@]}"; do
  guest defaults write -g AppleLanguages -array "$language" en
  guest killall ControlCenter NotificationCenter usernoted
  alert_and_banner "language-$language"
  say "language-$language"
  clear_all "language-$language"
done
