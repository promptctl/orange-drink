#!/bin/bash
# What NotificationCenter's accessibility tree shows for macOS's low battery notification, and for another app's with the same words,
# on the macOS of one Tart image, in a throwaway VM with no window. It prints a raw capture on stdout (scripts/notification-fixtures says
# what one is) and its progress on stderr: the macOS version, then every reading of the sweep, each tagged with its step.
# Run by `make notification-fixtures` and `make notification-fixtures-check`, once per image.
#
#   scripts/notification-capture <tart image>
#
# Exits 0 with the whole sweep printed, and 1 naming the step that never showed what it waited for.
set -euo pipefail

usage='usage: scripts/notification-capture <tart image>'
image=${1:?$usage}
cd "$(dirname "$0")/.."

. scripts/vm-check-lib
. scripts/notification-vm-lib

# The Mac's English is the first reading; these are the other languages the app is held to read, in the capture's order.
languages=(fr-FR ja zh-Hans ar pt-BR pl)

on_failure() {
  list >&2
  guest cat /tmp/battery.out >&2
}
say() { echo "notification-capture: $image: $*" >&2; }

# Whether the tree shows nothing at all. A tree that could not be read is not an empty one.
nothing_showing() { local showing; showing=$(list) && [ -z "$showing" ]; }
stack_gone() { local showing; showing=$(list) && ! grep -q '^AXNotificationCenterBannerStack' <<<"$showing"; }

# Prints the tree's notifications as records of <step> once it shows every subrole given, from the look that saw them: a banner fades,
# so a second look can find it gone.
snapshot() {
  local step=$1 seen subrole line
  shift
  for _ in $(seq 1 150); do
    seen=$(guest "$tree" values) || fail "$step: the tree could not be read"
    for subrole; do grep -q "^$subrole" <<<"$seen" || continue 2; done
    while IFS= read -r line; do printf '%s\t%s\n' "$step" "$line"; done <<<"$seen"
    return 0
  done
  fail "$step: the tree never showed $*"
}

# Raises the final warning, and has Script Editor post the alert's own words a second later: on macOS 26 a notification takes the
# top-right corner from a banner already showing, so the alert comes first.
alert_and_banner() {
  local alert title body
  wait_for "$1: the low battery alert never showed" 60 raise 3 ""
  alert=$(new_alerts "$(list)" "")
  IFS=$'\t' read -r _ title body _ <<<"$alert"
  post "$title" "$body"
  snapshot "$1" AXNotificationCenterAlert AXNotificationCenterBanner
}

# Withdraws the alert, and waits for the banners to fade, so the next step starts from nothing showing.
clear_all() {
  warn 1
  wait_for "$1: the notifications never went" 60 nothing_showing
}

notification_setup
printf 'macos\t%s\n' "$(guest sw_vers -productVersion)"

post First 'A banner'
snapshot banner AXNotificationCenterBanner
say "banner"
wait_for "banner: the banner never went" 60 nothing_showing

alert_and_banner final-warning
say "final-warning"
clear_all final-warning

# The stack is the banner above, kept in the panel. The clock toggles the panel, so it is pressed for the stack to show, read,
# and pressed again, and the stack is waited out: no reading after this is taken under an open panel.
wait_for "panel: the low battery alert never showed" 60 raise 3 ""
guest "$tree" panel
snapshot panel AXNotificationCenterAlert AXNotificationCenterBannerStack
guest "$tree" panel
wait_for "panel: the panel never closed" 30 stack_gone
say "panel"
clear_all panel

for language in "${languages[@]}"; do
  guest defaults write -g AppleLanguages -array "$language" en
  guest killall ControlCenter NotificationCenter usernoted
  alert_and_banner "language-$language"
  say "language-$language"
  clear_all "language-$language"
done
