#!/bin/bash
# Builds the disk image to hand to someone else and prints its path: the Release app signed with
# the Developer ID certificate, notarized and stapled, beside a link to /Applications to drag it
# onto, in a disk image that is itself signed, notarized and stapled.
#
#   scripts/dmg <output directory>
#
# The app is notarized and stapled before it is packed, so it still opens offline once dragged
# out of the image: stapling the image covers the image alone.
#
# [LAW:one-source-of-truth] The build is the Makefile's `release` recipe, which signs with the
# certificate project.yml names; this script gives it a derived-data directory of its own, so a
# release is always a clean build, and reads the app's path, name and version back off what it built.
set -euo pipefail

source "$(dirname "$0")/developer-id"

out=${1:?usage: scripts/dmg <output directory>}
# Made and resolved before the move to the repo root, which make needs, so a relative directory
# means the one the caller named.
mkdir -p "$out"
out=$(realpath "$out")
cd "$(dirname "$0")/.."

scratch=$(mktemp -d "${TMPDIR:-/tmp}/orangedrink-dmg.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

# HELPER_COPY is empty for the app users install, so its helper has the one fixed label across releases.
built=$(make --no-print-directory release DERIVED_DATA="$scratch/DerivedData" HELPER_COPY= | tee /dev/stderr | tail -n 1)
app=$(scripts/notarize "$built")

name=$(basename "$app" .app)
version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist")
stage="$scratch/stage"
mkdir "$stage"
ditto "$app" "$stage/$name.app"
ln -s /Applications "$stage/Applications"

# Made in scratch and moved out only once notarized, so the output directory never holds an image
# Gatekeeper would refuse, and a failed run leaves the last good one in place.
dmg="$scratch/$name-$version.dmg"
# hdiutil fails now and then with "Resource busy" on GitHub-hosted runners (actions/runner-images#7522), and by
# here the app's notarization is spent. So it gets a bounded retry, which says each failure.
attempt=1
until hdiutil create -ov -volname "$name" -srcfolder "$stage" -format UDZO "$dmg" >&2; do
  [ "$attempt" -lt 5 ] || { echo "dmg: hdiutil create failed $attempt times" >&2; exit 1; }
  echo "dmg: hdiutil create failed on attempt $attempt; trying again in 15 seconds" >&2
  attempt=$((attempt + 1))
  sleep 15
done
codesign --sign "$identity" --timestamp "$dmg" >&2
notarized=$(scripts/notarize "$dmg")
mv -f "$notarized" "$out/"
echo "$out/$(basename "$notarized")"
