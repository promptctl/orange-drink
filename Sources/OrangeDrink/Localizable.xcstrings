    "Remaining is the charge in the battery now; Current Full is what a full charge holds today; Design Capacity is what it held when new.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining is the charge in the battery now; Current Full is what a full charge holds today; Design Capacity is what it held when new."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restante : la charge actuellement dans la batterie ; Pleine charge actuelle : ce qu’une charge complète contient aujourd’hui ; Capacité d’origine : ce qu’elle contenait à l’état neuf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restante: la carga que hay ahora en la batería; Carga completa actual: lo que admite hoy una carga completa; Capacidad de diseño: lo que admitía cuando era nueva."
          }
        }
      }
    },
