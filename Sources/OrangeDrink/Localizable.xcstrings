    },
    "Devices are ranked by battery level, lowest first, so the one that needs charging is always at the top.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices are ranked by battery level, lowest first, so the one that needs charging is always at the top."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils sont classés par niveau de batterie, du plus bas au plus haut : celui qui doit être rechargé est toujours en haut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos se ordenan por nivel de batería, de menor a mayor, así el que necesita carga siempre queda arriba."
          }
        }
      }
    },
    "To see your iPhone or iPad battery, make sure it's Bluetooth-paired with this Mac via System Settings → Bluetooth.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your iPhone or iPad battery, make sure it's Bluetooth-paired with this Mac via System Settings → Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir la batterie de votre iPhone ou iPad, vérifiez qu’il est associé en Bluetooth à ce Mac dans Réglages Système → Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver la batería de tu iPhone o iPad, asegúrate de que esté vinculado por Bluetooth con este Mac en Ajustes del Sistema → Bluetooth."
          }
        }
      }
    },
    "Most devices provide exact battery levels. For some devices, we use approximate values prefixed with a tilde (~).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most devices provide exact battery levels. For some devices, we use approximate values prefixed with a tilde (~)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des appareils fournissent des niveaux de batterie exacts. Pour certains, nous utilisons des valeurs approximatives précédées d’un tilde (~)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los dispositivos indican el nivel de batería exacto. Para algunos usamos valores aproximados precedidos de una tilde (~)."
          }
        }
      }
    },
