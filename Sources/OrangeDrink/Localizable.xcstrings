    "Green when charging, orange for low battery. Off keeps the icon neutral and only turns it red when critical.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green when charging, orange for low battery. Off keeps the icon neutral and only turns it red when critical."
          }
