        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert en charge, orange quand la batterie est faible. Désactivé, l’icône reste neutre et ne devient rouge que si le niveau est critique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
